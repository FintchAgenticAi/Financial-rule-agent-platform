# Native Windows: http://127.0.0.1:11434
# Docker Desktop: http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Remote MCP server endpoints
TRANSFORMATION_MCP_URL=http://10.23.1.35:8010/mcp
VALIDATION_MCP_URL=http://VALIDATION_SERVER_IP:8030/mcp
DEDUPLICATION_MCP_URL=http://DEDUPLICATION_SERVER_IP:8000/mcp

R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY
R2_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
R2_BUCKET=financial-rule-platform-dev
R2_TEST_OBJECT_KEY=datasets/ds-001/sample_financial_data.csv
R2_LOCAL_DOWNLOAD_PATH=data/r2_test_input.csv

# Phase 4 rule-manager API
RULE_MANAGER_API_TOKEN=replace-with-a-long-random-token
RULE_MANAGER_APPROVED_CALLBACK_URL=https://dpm.example.com/api/v1/rule-selection-results

# Phase 5 durable asynchronous processing
# Named volume mount: /app/job-state. Shared by api, worker and recovery.
JOB_DATABASE_PATH=/app/job-state/jobs.db
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=rule-selection
RQ_JOB_TIMEOUT_SECONDS=1800
RQ_JOB_LEASE_SECONDS=1800
RQ_MAX_RETRIES=3
JOB_RECOVERY_ENABLED=true
JOB_RECOVERY_INTERVAL_SECONDS=15
